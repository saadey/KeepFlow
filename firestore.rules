rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'description', 'isCompleted', 'isDeleted', 'priority', 'userId', 'createdAt', 'updatedAt'])
        && data.keys().size() == 8
        && data.title is string && data.title.size() <= 500
        && data.description is string && data.description.size() <= 2000
        && data.isCompleted is bool
        && data.isDeleted is bool
        && data.priority in ['none', 'important']
        && data.userId == request.auth.uid
        && data.createdAt is int
        && data.updatedAt is int;
    }

    match /tasks/{taskId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidTask(incoming()) 
        && incoming().createdAt == request.time.toMillis()
        && incoming().updatedAt == request.time.toMillis();

      allow update: if isOwner(existing().userId)
        && isValidTask(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time.toMillis()
        && (
          // Action: Mark completed
          (incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'updatedAt'])) ||
          // Action: Rename or change description
          (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'updatedAt'])) ||
          // Action: Change priority
          (incoming().diff(existing()).affectedKeys().hasOnly(['priority', 'updatedAt'])) ||
          // Action: Recycle Bin operations
          (incoming().diff(existing()).affectedKeys().hasOnly(['isDeleted', 'updatedAt']))
        );

      allow delete: if isOwner(existing().userId);
    }
  }
}
